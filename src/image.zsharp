import Std.Os;
import Std.Path;
import Workspace.util;
import Workspace.config;
import Workspace.initrd;
import Workspace.overlay;

##
 * image — squashfs, drzewo ISO (jądro, initrd, GRUB BIOS+UEFI, opcjonalnie shim), xorriso hybrid ISO, tar/squashfs jako osobne wyjścia.
 * Narzędzia: mksquashfs, xorriso, grub2-mkimage|grub-mkimage, mkfs.vfat, mtools (mmd, mcopy).
##

func archPlatforms($arch) {
    return $arch === "x86_64" ? ["i386-pc", "x86_64-efi"] : ["arm64-efi"];
}

func efiFile($arch) { return $arch === "x86_64" ? "BOOTX64.EFI" : "BOOTAA64.EFI"; }
func efiPlat($arch) { return $arch === "x86_64" ? "x86_64-efi" : "arm64-efi"; }

func grubTool($x) {
    foreach (["grub2-mkimage", "grub-mkimage"] as $t) { if (Os.which($t) !== null) { return $t; } }
    if ($x->r->dry) { return "grub2-mkimage"; }
    util.die("brak grub2-mkimage/grub-mkimage na hoście (pakiet grub2 + grub2-<platforma>)");
}

func grubModDir($x, $plat) {
    foreach (["/usr/share/grub2/" . $plat, "/usr/lib/grub/" . $plat, "/usr/lib/grub2/" . $plat] as $d) {
        if (Os.isDir($d)) { return $d; }
    }
    if ($x->r->dry) { return "/usr/share/grub2/" . $plat; }
    util.die("brak modułów GRUB dla " . $plat . " (zainstaluj grub2-" . $plat . " na hoście)");
}

# ── squashfs ──
func squashfs($x, $dest) {
    $comp = $x->cfg("build.compression");
    $a = ["mksquashfs", $x->rootfs(), $dest, "-noappend", "-comp", $comp, "-b", strval($x->cfg("build.block_size")), "-quiet"];
    if ($comp === "zstd") { $a[] = "-Xcompression-level"; $a[] = strval($x->cfg("build.compression_level")); }
    $sde = strval($x->cfg("build.source_date_epoch"));
    if ($sde !== "") { $a = [...$a, "-all-time", $sde, "-mkfs-time", $sde]; }
    $x->r->mkdir(Path.dirname($dest));
    $x->r->run($a);
}

# ── parametry jądra / grub.cfg ──
func kernelParams($x, $extra = []) {
    $label = $x->cfg("distro.iso_label");
    $p = [];
    if ($x->cfg("live.enabled")) {
        $p[] = "root=live:CDLABEL=" . $label;
        foreach (util.asList($x->cfg("live.kernel_params")) as $k) { $p[] = $k; }
        $ov = $x->cfg("live.overlay");
        if ($ov === "tmpfs") { $p[] = "rd.live.overlay.overlayfs=1"; }
        elseif ($ov !== "" && $ov !== "none") { $p[] = "rd.live.overlay=" . $ov; }
    }
    if (config.initPath($x->c) !== "") { $p[] = "init=" . config.initPath($x->c); }
    foreach (util.asList($x->cfg("boot.kernel_params")) as $k) { $p[] = $k; }
    return util.uniq([...$p, ...$extra]);
}

func grubCfg($x, $withEfiExtras) {
    $name = $x->cfg("boot.menu_title") !== "" ? $x->cfg("boot.menu_title") : $x->cfg("distro.name") . " " . strval($x->cfg("distro.version"));
    $arch = $x->arch();
    $ld = "/boot/" . $arch . "/loader";
    $label = $x->cfg("distro.iso_label");
    $o = "set timeout=" . strval($x->cfg("boot.timeout")) . "\nset default=0\n";
    $o .= "insmod part_gpt\ninsmod part_msdos\ninsmod iso9660\ninsmod all_video\n";
    $o .= "search --no-floppy --set=root --label " . $label . "\n\n";
    $entries = [[$name, []], [$name . " (safe graphics)", ["nomodeset"]]];
    if ($x->initSystem() === "zenitd") { $entries[] = [$name . " (rescue)", ["zenit.unit=rescue"]]; }
    $entries[] = [$name . " (verbose)", ["loglevel=7", "-quiet"]];
    foreach ($entries as $e) {
        $params = kernelParams($x);
        foreach ($e[1] as $extra) {
            if (starts_with($extra, "-")) { $params = util.without($params, [substr($extra, 1)]); }
            else { $params[] = $extra; }
        }
        $o .= "menuentry \"" . $e[0] . "\" {\n    linux " . $ld . "/linux " . join($params, " ") . "\n    initrd " . $ld . "/initrd\n}\n";
    }
    if ($withEfiExtras) { $o .= "\nmenuentry \"UEFI Firmware Settings\" {\n    fwsetup\n}\n"; }
    return $o;
}

# ── drzewo ISO ──
func stageBoot($x) {
    $iso = $x->isoroot();
    $arch = $x->arch();
    $ld = util.pjoin($iso, "boot/" . $arch . "/loader");
    $x->r->mkdir($ld);
    $kf = initrd.findKernelFile($x);
    $x->r->run(["cp", "-L", util.pjoin($x->rootfs(), $kf), util.pjoin($ld, "linux")]);
    $x->r->run(["cp", "-L", util.pjoin($x->rootfs(), "boot/initrd-" . $x->kver), util.pjoin($ld, "initrd")]);
    $x->r->mkdir(util.pjoin($iso, "boot/grub2"));
    $x->r->write(util.pjoin($iso, "boot/grub2/grub.cfg"), grubCfg($x, $x->cfg("boot.uefi")), 420);
    $x->r->write(util.pjoin($iso, "boot/grub2/early.cfg"),
        "search --no-floppy --set=root --label " . $x->cfg("distro.iso_label") . "\nset prefix=(\$root)/boot/grub2\nconfigfile (\$root)/boot/grub2/grub.cfg\n", 420);
}

func mkimage($x, $plat, $out) {
    $mods = "iso9660 part_gpt part_msdos fat normal linux search search_label configfile echo test all_video loopback squash4 ls chain boot gzio";
    if ($plat === "i386-pc") { $mods .= " biosdisk"; } else { $mods .= " efi_gop"; }
    if ($plat === "x86_64-efi") { $mods .= " efi_uga"; }
    $x->r->run([grubTool($x), "-O", $plat, "-o", $out, "-p", "/boot/grub2", "-d", grubModDir($x, $plat),
        "-c", util.pjoin($x->isoroot(), "boot/grub2/early.cfg"), ...split($mods, " ")]);
}

func stageBios($x) {
    $iso = $x->isoroot();
    $dir = util.pjoin($iso, "boot/grub2/i386-pc");
    $x->r->mkdir($dir);
    $x->r->run(["cp", "-a", grubModDir($x, "i386-pc") . "/.", $dir . "/"]);
    $core = util.pjoin($x->p["work_dir"], "core.img");
    mkimage($x, "i386-pc", $core);
    $x->r->sh("cat " . util.shq($dir . "/cdboot.img") . " " . util.shq($core) . " > " . util.shq($dir . "/eltorito.img"));
}

func stageEfi($x) {
    $iso = $x->isoroot();
    $arch = $x->arch();
    $plat = efiPlat($arch);
    $work = $x->p["work_dir"];
    $efi = util.pjoin($work, efiFile($arch));
    $dir = util.pjoin($iso, "boot/grub2/" . $plat);
    $x->r->mkdir($dir);
    $x->r->run(["cp", "-a", grubModDir($x, $plat) . "/.", $dir . "/"]);
    $x->r->mkdir(util.pjoin($iso, "EFI/BOOT"));
    $files = [];
    if ($x->cfg("boot.secure_boot")) {
        # shim + podpisany grub z rootfs (pakiety shim, grub2-<platforma>-efi); eksperymentalne
        util.warn("boot.secure_boot jest eksperymentalne i nie było testowane na sprzęcie z włączonym Secure Boot");
        $src = "usr/share/efi/" . $arch;
        $x->r->run(["cp", util.pjoin($x->rootfs(), $src . "/shim.efi"), util.pjoin($iso, "EFI/BOOT/" . efiFile($arch))]);
        $x->r->run(["cp", util.pjoin($x->rootfs(), $src . "/grub.efi"), util.pjoin($iso, "EFI/BOOT/grub.efi")]);
        $x->r->run(["cp", util.pjoin($x->rootfs(), $src . "/MokManager.efi"), util.pjoin($iso, "EFI/BOOT/MokManager.efi")], ["ok" => true]);
        $x->r->run(["cp", util.pjoin($iso, "boot/grub2/grub.cfg"), util.pjoin($iso, "EFI/BOOT/grub.cfg")]);
    } else {
        mkimage($x, $plat, $efi);
        $x->r->run(["cp", $efi, util.pjoin($iso, "EFI/BOOT/" . efiFile($arch))]);
    }
    # obraz FAT dla El Torito (alt-boot) — rozmiar wg zawartości
    $img = util.pjoin($iso, "EFI/efiboot.img");
    $x->r->sh("sz=\$(( \$(du -sk " . util.shq($iso . "/EFI/BOOT") . " | cut -f1) + 2048 )); truncate -s \${sz}K " . util.shq($img) .
        " && mkfs.vfat -n ZLB_EFI " . util.shq($img) . " >/dev/null && mmd -i " . util.shq($img) . " ::/EFI ::/EFI/BOOT && mcopy -i " . util.shq($img) . " -s " . util.shq($iso . "/EFI/BOOT") . "/* ::/EFI/BOOT/");
}

func xorrisoArgs($x, $out) {
    $iso = $x->isoroot();
    $arch = $x->arch();
    $pub = $x->cfg("distro.publisher");
    $a = ["xorriso", "-as", "mkisofs", "-quiet", "-iso-level", "3", "-full-iso9660-filenames", "-joliet", "-joliet-long", "-rational-rock",
        "-volid", $x->cfg("distro.iso_label"), "-publisher", $pub, "-appid", $x->cfg("distro.name"),
        "-preparer", "zlb (Zenit Linux Builder)"];
    $bios = $x->cfg("boot.bios");
    $uefi = $x->cfg("boot.uefi");
    if ($bios) {
        $a = [...$a, "-isohybrid-mbr", util.pjoin($iso, "boot/grub2/i386-pc/boot_hybrid.img"),
            "-eltorito-boot", "boot/grub2/i386-pc/eltorito.img", "-no-emul-boot", "-boot-load-size", "4", "-boot-info-table", "--grub2-boot-info",
            "-eltorito-catalog", "boot/grub2/boot.cat"];
    }
    if ($uefi) {
        if ($bios) { $a[] = "-eltorito-alt-boot"; }
        $a = [...$a, "-e", "EFI/efiboot.img", "-no-emul-boot", "-isohybrid-gpt-basdat"];
    }
    $sde = strval($x->cfg("build.source_date_epoch"));
    if ($sde !== "") { $a = [...$a, "--modification-date=" . gmtStamp($sde)]; }
    return [...$a, "-o", $out, $iso];
}

# YYYYMMDDhhmmssff z epoch (dla reproducible ISO)
func gmtStamp($epoch) {
    $days = intval($epoch / 86400);
    $rem = $epoch - $days * 86400;
    $z = $days + 719468;
    $era = intval($z / 146097);
    $doe = $z - $era * 146097;
    $yoe = intval(($doe - intval($doe / 1460) + intval($doe / 36524) - intval($doe / 146096)) / 365);
    $y = $yoe + $era * 400;
    $doy = $doe - (365 * $yoe + intval($yoe / 4) - intval($yoe / 100));
    $mp = intval((5 * $doy + 2) / 153);
    $d = $doy - intval((153 * $mp + 2) / 5) + 1;
    $m = $mp < 10 ? $mp + 3 : $mp - 9;
    if ($m <= 2) { $y++; }
    return util.padNum($y, 4) . util.padNum($m) . util.padNum($d) . util.padNum(intval($rem / 3600)) . util.padNum(intval(($rem % 3600) / 60)) . util.padNum($rem % 60) . "00";
}

func buildIso($x) {
    $iso = $x->isoroot();
    $x->r->rmrf($iso);
    $x->r->mkdir($iso);
    squashfs($x, util.pjoin($iso, "LiveOS/squashfs.img"));
    stageBoot($x);
    if ($x->cfg("boot.bios")) { stageBios($x); }
    if ($x->cfg("boot.uefi")) { stageEfi($x); }
    overlay.isoFiles($x);
    $out = util.pjoin($x->p["output_dir"], config.isoName($x->c));
    $x->r->mkdir($x->p["output_dir"]);
    $x->r->run(xorrisoArgs($x, $out));
    return $out;
}


func baseName($x): string {
    $n = config.isoName($x->c);
    return ends_with($n, ".iso") ? substr($n, 0, strlen($n) - 4) : $n;
}

# wszystkie formaty z build.formats; zwraca listę ścieżek plików wynikowych
func exportAll($x) {
    $outs = [];
    $od = $x->p["output_dir"];
    $x->r->mkdir($od);
    foreach (util.asList($x->cfg("build.formats")) as $f) {
        if ($f === "iso") { $outs[] = buildIso($x); }
        elseif ($f === "squashfs") {
            $o = util.pjoin($od, baseName($x) . ".squashfs");
            squashfs($x, $o);
            $outs[] = $o;
        }
        elseif ($f === "tar") {
            $o = util.pjoin($od, baseName($x) . ".rootfs.tar.zst");
            $x->r->run(["tar", "--xattrs", "--acls", "--numeric-owner", "--one-file-system", "-C", $x->rootfs(), "-I", "zstd -T0 -19", "-cf", $o, "."]);
            $outs[] = $o;
        }
    }
    return $outs;
}

# ścieżki, które exportAll wytworzy (do finalizacji przy wznowieniu)
func expected($x) {
    $od = $x->p["output_dir"];
    $o = [];
    foreach (util.asList($x->cfg("build.formats")) as $f) {
        if ($f === "iso") { $o[] = util.pjoin($od, config.isoName($x->c)); }
        elseif ($f === "squashfs") { $o[] = util.pjoin($od, baseName($x) . ".squashfs"); }
        elseif ($f === "tar") { $o[] = util.pjoin($od, baseName($x) . ".rootfs.tar.zst"); }
    }
    return $o;
}
