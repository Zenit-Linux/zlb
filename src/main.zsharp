import Std.Os;
import Workspace.util;
import Workspace.cli;

##
 * zlb — Zenit Linux Builder (wejście). Błędy użytkownika (ZlbError) → komunikat i kod 1; reszta → ślad i kod 70.
##
func main(): int {
    try {
        return cli.run(Os.args());
    } catch (ZlbError $e) {
        util.err($e->getMessage());
        return 1;
    } catch (Exception $e) {
        util.err("wewnętrzny błąd: " . $e->getMessage());
        return 70;
    }
}
